project_id  = "YOUR_GCP_PROJECT_ID"
region      = "us-central1"
name_prefix = "venafi-cert"
cert_name   = "app-tls"

# ---------------------------------------------------------------------------
# CORE / CLIENT (default): renew existing certificates only
# ---------------------------------------------------------------------------
enable_lab_stack          = false
seed_expired_certificates = false
secondary_cert_name       = ""
enable_mock               = false
seed_mock_secret_versions = false

venafi_platform       = "tpp"
venafi_base_url       = "https://venafi.example.com"
venafi_certificate_dn = "\\\\VED\\\\Policy\\\\Apps\\\\app.example.com"

# Install into the client's existing Certificate Manager map:
cert_install_method   = "cm_api"
cert_map_name         = "YOUR_EXISTING_CERT_MAP"
cert_map_entry_name   = "YOUR_EXISTING_MAP_ENTRY"

# Or use a client-owned Cloud Build / Terraform trigger:
# cert_install_method            = "tf_cloudbuild"
# external_tf_cloudbuild_trigger = "your-existing-trigger-name"

# ---------------------------------------------------------------------------
# LAB / VALIDATION ONLY (do not use in client production)
# ---------------------------------------------------------------------------
# enable_lab_stack              = true
# seed_expired_certificates     = true
# seed_days_until_expiry        = 7
# secondary_cert_name           = "edge-tls"
# secondary_cert_common_name    = "edge.example.local"
# enable_mock                   = true
# seed_mock_secret_versions     = true
# cert_install_method           = "tf_cloudbuild"
